@model Taller_Todo_Terreno.Models.Cita

@{
    ViewData["Title"] = "Cancelar Cita";
}

<h1>Cancelar Cita</h1>

<h3>¿Estás seguro de que deseas cancelar esta cita?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Vehículo (Placa)</dt>
        <dd class="col-sm-10">@Model.Vehiculo.Placa</dd>

        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.Horario.Fecha.ToShortDateString()</dd>

        <dt class="col-sm-2">Hora</dt>
        <dd class="col-sm-10">@Model.Horario.HoraInicio - @Model.Horario.HoraFin</dd>
    </dl>

    <form asp-action="Cancel">
        <input type="hidden" asp-for="CitaId" />
        <input type="submit" value="Sí, cancelar cita" class="btn btn-danger" /> |
        <a asp-action="Index">Volver</a>
    </form>
</div>

@model Taller_Todo_Terreno.Models.Vehiculo
@{
    ViewData["Title"] = "Eliminar Vehículo";
}
<h1>Eliminar Vehículo</h1>
<h3>¿Estás seguro de que deseas eliminar este vehículo?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Placa)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Placa)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Marca)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Marca)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Modelo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Modelo)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Año)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Año)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TipoTransmision)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TipoTransmision)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Dueno)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Dueno.Nombre)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="VehiculoId" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Volver a la lista</a>
    </form>
</div>
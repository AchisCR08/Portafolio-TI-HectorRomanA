<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="cifrado.clave" value="REEMPLAZAR_EN_CONFIGURACION_LOCAL" />
    <add key="Mongo.ConnectionString" value="mongodb://localhost:27017" />
    <add key="Mongo.BaseDatos" value="TelefoniaAuth" />
    <add key="Mongo.Coleccion" value="usuarios" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.serviceModel>
    <services>
      <service name="WS_Autenticacion.AutenticacionService">
        <endpoint address="" binding="basicHttpBinding" contract="WS_Autenticacion.IAutenticacionService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior>
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
  </system.serviceModel>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="DnsClient" publicKeyToken="4574bb5573c51424" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.6.1.0" newVersion="1.6.1.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>


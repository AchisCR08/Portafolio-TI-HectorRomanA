<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Identificador.Host" value="localhost" />
    <add key="Identificador.Puerto" value="8000" />
    <add key="Identificador.TimeoutMs" value="5000" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.serviceModel>
    <services>
      <service name="WS_Identificador.IdentificadorService">
        <endpoint address="" binding="basicHttpBinding" contract="WS_Identificador.IIdentificadorService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior>
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
  </system.serviceModel>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
</configuration>

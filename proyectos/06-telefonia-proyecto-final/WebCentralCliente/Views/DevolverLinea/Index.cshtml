@model WebCentralCliente.Infraestructura.LineaClienteDTO[]
@using System.Linq
@{ ViewBag.Title="Devolver una línea"; ViewBag.PageTitle="Devolver una línea telefónica"; var prepago=(Model ?? new WebCentralCliente.Infraestructura.LineaClienteDTO[0]).Where(x => string.Equals(x.TipoServicio,"prepago",System.StringComparison.OrdinalIgnoreCase)); var postpago=(Model ?? new WebCentralCliente.Infraestructura.LineaClienteDTO[0]).Where(x => string.Equals(x.TipoServicio,"postpago",System.StringComparison.OrdinalIgnoreCase)); }
<div class="panel p-3 mb-4"><h5>Líneas prepago</h5><table class="table align-middle"><thead><tr><th>Número</th><th>Saldo disponible</th><th></th></tr></thead><tbody>@foreach(var l in prepago){<tr><td>@l.NumeroTelefono</td><td>@l.Saldo.ToString("C")</td><td><form method="post" action="@Url.Action("Devolver")" onsubmit="return confirm('¿Está seguro de querer devolver la línea telefónica?');">@Html.AntiForgeryToken()<input type="hidden" name="numeroTelefono" value="@l.NumeroTelefono"/><button class="btn btn-outline-danger btn-sm">Devolver</button></form></td></tr>}</tbody></table>@if(!prepago.Any()){<div class="alert alert-info">No tiene líneas prepago registradas.</div>}</div>
<div class="panel p-3"><h5>Líneas postpago</h5><table class="table align-middle"><thead><tr><th>Número</th><th>Factura pendiente</th><th></th></tr></thead><tbody>@foreach(var l in postpago){ bool deuda=l.MontoFacturaPendiente>0;<tr><td>@l.NumeroTelefono</td><td>@l.MontoFacturaPendiente.ToString("C")</td><td><form method="post" action="@Url.Action("Devolver")" onsubmit="return confirm('¿Está seguro de querer devolver la línea telefónica?');">@Html.AntiForgeryToken()<input type="hidden" name="numeroTelefono" value="@l.NumeroTelefono"/><button class="btn btn-outline-danger btn-sm" @(deuda ? "disabled" : "")>Devolver</button></form></td></tr>}</tbody></table>@if(!postpago.Any()){<div class="alert alert-info">No tiene líneas postpago registradas.</div>}<p class="text-muted mb-0">Las líneas con factura pendiente deben cancelarse antes de devolverlas.</p></div>

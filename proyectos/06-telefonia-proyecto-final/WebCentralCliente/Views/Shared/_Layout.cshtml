<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Central General</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/site.css")" rel="stylesheet" />
</head>
<body class="cliente-body">
    <header class="cabecera">
        <div class="container-fluid d-flex align-items-center justify-content-between gap-3">
            <a href="@Url.Action("Index", "MisLineas")" class="marca">
                <img src="@Url.Content("~/Images/logo.png")" alt="Central General" class="logo" />
                <span class="titulo-sitio">Central General</span>
            </a>
            <span class="badge text-bg-light panel-badge">Hola @WebCentralCliente.Utilidades.SesionHelper.ObtenerNombreUsuario()</span>
        </div>
    </header>

    <div class="admin-shell container-fluid">
        <div class="row g-0">
            <nav class="col-md-3 col-lg-2 sidebar" aria-label="Menu del cliente">
                <div class="sidebar-heading">Mi cuenta</div>
                <ul class="nav flex-column admin-menu">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "MisLineas")">Mostrar líneas activas a mi nombre</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "RecargarSaldo")">Cargar saldo a línea prepago</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "PagarFactura")">Pagar facturas pendientes de pago</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "DevolverLinea")">Devolver una línea</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link salir-link" href="@Url.Action("Salir", "Account")">Salir del sitio</a>
                    </li>
                </ul>
            </nav>

            <main class="col-md-9 col-lg-10 contenido">
                <div class="page-header">
                    <div>
                        <p class="section-kicker">Sistema de Control de Llamadas Telefónicas</p>
                        <h1>@(ViewBag.PageTitle ?? ViewBag.Title ?? "Portal del cliente")</h1>
                    </div>
                </div>

                <div class="alertas">
                    @if (TempData["Mensaje"] != null)
                    {
                        <div class="alert alert-success">@TempData["Mensaje"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                </div>

                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="pie-pagina">
        <div class="container-fluid">
            <p>&copy; @DateTime.Now.Year - Central General. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

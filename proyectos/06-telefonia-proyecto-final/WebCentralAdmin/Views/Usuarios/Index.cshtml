@model WebCentralAdmin.Infraestructura.UsuarioDTO[]
@{ ViewBag.Title="Usuarios administrativos"; ViewBag.PageTitle="Mantenimiento de usuarios administradores"; }
<div class="panel p-3 mb-3 text-end"><a class="btn btn-primary" href="@Url.Action("Nuevo")">Nuevo</a></div>
@if (Model == null || Model.Length == 0) { <div class="alert alert-info">No hay usuarios administradores registrados.</div> } else { <div class="table-responsive"><table class="table table-hover table-sm align-middle"><thead><tr><th>Identificación</th><th>Nombre</th><th>Apellidos</th><th>Correo</th><th>Usuario</th><th>Contraseña</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach(var u in Model) { <tr><td>@u.Identificacion</td><td>@u.Nombre</td><td>@u.PrimerApellido @u.SegundoApellido</td><td>@u.CorreoElectronico</td><td>@u.Usuario</td><td>@u.Contrasena</td><td>@u.Estado</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="@Url.Action("Editar", new { id=u.Identificacion })">Modificar</a> <form class="d-inline" method="post" action="@Url.Action("CambiarEstado")">@Html.AntiForgeryToken()<input type="hidden" name="identificacion" value="@u.Identificacion"/><input type="hidden" name="estado" value="@u.Estado"/><button class="btn btn-sm btn-outline-secondary">@(string.Equals(u.Estado,"activo",System.StringComparison.OrdinalIgnoreCase) ? "Inactivar" : "Activar")</button></form> <form class="d-inline" method="post" action="@Url.Action("Eliminar")" onsubmit="return confirm('¿Está seguro de eliminar el registro del usuario de forma definitiva?');">@Html.AntiForgeryToken()<input type="hidden" name="identificacion" value="@u.Identificacion"/><button class="btn btn-sm btn-outline-danger">Eliminar</button></form></td></tr> }
</tbody></table></div> }

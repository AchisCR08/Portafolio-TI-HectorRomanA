@model WebCentralAdmin.Models.UsuarioAdminViewModel
@{ bool editar = !string.IsNullOrWhiteSpace(Model.Identificacion); ViewBag.Title=editar ? "Modificar administrador" : "Nuevo administrador"; ViewBag.PageTitle=ViewBag.Title; }
@if (!string.IsNullOrWhiteSpace(ViewBag.Error as string)) { <div class="alert alert-danger">@ViewBag.Error</div> }
<div class="panel p-4"><form method="post" action="@Url.Action(editar ? "Editar" : "Nuevo")">@Html.AntiForgeryToken()<div class="row g-3"><div class="col-md-4"><label class="form-label">Identificación</label><input class="form-control" name="Identificacion" value="@Model.Identificacion" @(editar ? "readonly" : "") required /></div><div class="col-md-4"><label class="form-label">Nombre</label><input class="form-control" name="Nombre" value="@Model.Nombre" required /></div><div class="col-md-4"><label class="form-label">Primer apellido</label><input class="form-control" name="PrimerApellido" value="@Model.PrimerApellido" required /></div><div class="col-md-4"><label class="form-label">Segundo apellido</label><input class="form-control" name="SegundoApellido" value="@Model.SegundoApellido" required /></div><div class="col-md-4"><label class="form-label">Correo electrónico</label><input type="email" class="form-control" name="CorreoElectronico" value="@Model.CorreoElectronico" required /></div><div class="col-md-4"><label class="form-label">Usuario</label><input class="form-control" name="Usuario" value="@Model.Usuario" required /></div><div class="col-md-6"><label class="form-label">Contraseña</label><input type="password" class="form-control" name="Contrasena" required /><small class="text-muted">14 caracteres con mayúscula, minúscula, número y carácter especial.</small></div></div><div class="mt-4"><button class="btn btn-primary">@(editar ? "Guardar cambios" : "Registrar")</button> <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Cancelar</a></div></form></div>

@model WebCentralAdmin.Infraestructura.LineaDisponibleDTO[]

@{
    ViewBag.Title = "Nuevas líneas";
    ViewBag.PageTitle = "Poner a disposición nuevas líneas telefónicas";
}

<div class="panel d-flex justify-content-between align-items-center p-3 mb-3">
    <p class="mb-0 text-muted">Líneas disponibles para la venta (sin vender).</p>
    <a href="@Url.Action("Nuevo", "Lineas")" class="btn btn-primary">Nuevo</a>
</div>

@if (Model == null || Model.Length == 0)
{
    <div class="alert alert-info">No hay líneas disponibles.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Número de teléfono</th>
                    <th>Identificador de tarjeta</th>
                    <th>Tipo de servicio</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var linea in Model)
                {
                    <tr>
                        <td>@linea.NumeroTelefono</td>
                        <td>@(string.IsNullOrEmpty(linea.IdentificadorTarjeta) ? "-" : linea.IdentificadorTarjeta)</td>
                        <td>
                            <span class="badge text-bg-secondary">@linea.TipoServicio</span>
                        </td>
                        <td class="text-end">
                            <form method="post"
                                  action="@Url.Action("Eliminar", "Lineas")"
                                  onsubmit="return confirm('¿Está seguro de borrar la línea telefónica?');">
                                <input type="hidden" name="numeroTelefono" value="@linea.NumeroTelefono" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

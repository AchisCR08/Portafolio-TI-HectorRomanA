@{
    ViewBag.Title = "Ingresar";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<section class="auth-card">
    <div class="auth-brand">
        <img src="@Url.Content("~/Images/logo.png")" alt="Central General" class="auth-logo" />
        <div>
            <p class="auth-kicker">Panel administrativo</p>
            <h1>Central General</h1>
        </div>
    </div>

    <p class="auth-copy">Ingrese sus credenciales para administrar lineas telefonicas, facturacion y usuarios del sistema.</p>

    @if (!string.IsNullOrEmpty(ViewBag.Mensaje))
    {
        <div class="alert alert-info">@ViewBag.Mensaje</div>
    }

    <div class="alert alert-secondary auth-note">
        <strong>ADM1:</strong> formulario provisional. La validacion final debe consumir WS_AUTENTICACION1 como administrador y enviar la contrasena cifrada.
    </div>

    <form method="post" action="@Url.Action("Login", "Account")">
        <div class="mb-3">
            <label class="form-label" for="usuario">Usuario</label>
            <input type="text" id="usuario" name="usuario" class="form-control form-control-lg" autocomplete="username" />
        </div>
        <div class="mb-4">
            <label class="form-label" for="contrasena">Contrasena</label>
            <input type="password" id="contrasena" name="contrasena" class="form-control form-control-lg" autocomplete="current-password" />
        </div>
        <button type="submit" class="btn btn-primary btn-lg w-100">Ingresar</button>
    </form>
</section>

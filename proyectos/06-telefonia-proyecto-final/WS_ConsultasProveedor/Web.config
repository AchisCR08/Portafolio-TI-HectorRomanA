<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Cifrado.Clave" value="REEMPLAZAR_EN_CONFIGURACION_LOCAL" />
    <add key="WS_Autenticacion.Url" value="http://localhost:55960/AutenticacionService.svc" />
  </appSettings>
  <connectionStrings>
    <add name="TelefoniaContext"
		 connectionString="Server=localhost\SQLEXPRESS;Database=Telefonia;User Id=telefonia_user;Password=REEMPLAZAR_EN_CONFIGURACION_LOCAL;"
         
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.serviceModel>
    <services>
      <service name="WS_ConsultasProveedor.ConsultasProveedorService">
        <endpoint address="" binding="basicHttpBinding" contract="WS_ConsultasProveedor.IConsultasProveedorService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior>
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
  </system.serviceModel>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
</configuration>

@model WebCentralCliente.Models.LoginViewModel

@{
    ViewBag.Title = "Ingresar";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<section class="auth-card">
    <div class="auth-brand">
        <img src="@Url.Content("~/Images/logo.png")" alt="Central General" class="auth-logo" />
        <div>
            <p class="auth-kicker">Portal del cliente</p>
            <h1>Central General</h1>
        </div>
    </div>

    <p class="auth-copy">Ingrese sus credenciales para consultar sus líneas, cargar saldo y pagar facturas.</p>

    @if (!string.IsNullOrEmpty(ViewBag.Mensaje))
    {
        <div class="alert alert-info">@ViewBag.Mensaje</div>
    }

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label" for="Usuario">Usuario</label>
            <input type="text" id="Usuario" name="Usuario" value="@Model?.Usuario" class="form-control form-control-lg" autocomplete="username" />
        </div>
        <div class="mb-4">
            <label class="form-label" for="Contrasena">Contraseña</label>
            <input type="password" id="Contrasena" name="Contrasena" class="form-control form-control-lg" autocomplete="current-password" />
        </div>
        <button type="submit" class="btn btn-primary btn-lg w-100">Ingresar</button>
    }

    <p class="auth-copy text-center mt-3 mb-0">
        ¿No tiene cuenta? <a href="@Url.Action("Index", "Registro")">Regístrese aquí</a>
    </p>
</section>
